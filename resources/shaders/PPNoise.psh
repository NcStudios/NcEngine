Texture2D     Textures[];
Texture2D     ColorSinks[];
Texture2D     DepthSinks[];
Texture2D     PostProcessSinks[];
SamplerState  ColorSinks_sampler; // By convention, texture samplers must use the '_sampler' suffix

cbuffer EnvironmentProperties
{
    float4x4 cameraViewProjection;
    float4x4 cameraInvProjection;
    float3 cameraPosition;
    uint lightCount;
    float nearClip;
    float farClip;
};

cbuffer SinkIndices
{
    int colorRT1;
    int colorRT2;
    int colorRT3;
    int colorRT4;
    int depthRT1;
    int depthRT2;
    int depthRT3;
    uint hasPostProcess;
    uint lightIndex;
};

cbuffer PostProcessProperties
{
    float3 gradientStart;
    float gradientAmount;
    float3 gradientEnd;
    uint noiseTexIndex;
    float noiseTexAmount;
    float noiseTexTiling;
};

struct PSInput 
{ 
    float4 Pos : SV_POSITION;
    float2 UV  : TEX_COORD; 
};

struct PSOutput
{
    float4 Color : SV_TARGET;
};

float RgbToLuma(float3 rgb){
    return sqrt(dot(rgb, float3(0.299, 0.587, 0.114)));
}

void main(in PSInput PSIn, out PSOutput PSOut)
{
    // Alias the resource names
    SamplerState smplr = ColorSinks_sampler;
    Texture2D sceneColorTex = PostProcessSinks[0];
    Texture2D noiseTex = Textures[noiseTexIndex];
    float3 sceneColor = sceneColorTex.Sample(smplr, PSIn.UV);
    float3 noiseColor = noiseTex.Sample(smplr, PSIn.UV * noiseTexTiling);

    // Gradient for mask
    float3 gradient = lerp(gradientStart, gradientEnd, PSIn.UV.y);
    float4 gradientApplied = float4(lerp(sceneColor, sceneColor + gradient, gradientAmount), 1.0f);

    // Noise
    float3 luma = RgbToLuma(gradientApplied);
    float3 noiseApplied = lerp(sceneColor, sceneColor + noiseColor, (1-luma.r) * noiseTexAmount);

    PSOut.Color = float4(noiseApplied, 1.0f);
}