#ifdef VULKAN
// NonUniformResourceIndex is not supported by GLSLang
#   define NonUniformResourceIndex(x) x
#endif

Texture2D     PostProcessColorSinkBufferData[];
Texture2D     PostProcessDepthSinkBufferData[];
SamplerState  PostProcessColorSinkBufferData_sampler; // By convention, texture samplers must use the '_sampler' suffix

cbuffer EnvironmentBufferData
{
    float4x4 cameraViewProjection;
    float4x4 cameraInvProjection;
    float3 cameraPosition;
    uint dirLightsCount;
    uint pointLightsCount;
    uint spotLightsCount;
    float2 padding;
};

cbuffer PostProcessSinkIndexBufferData
{
    uint colorRT1;
    uint colorRT2;
    uint colorRT3;
    uint colorRT4;
    uint depthRT1;
    uint depthRT2;
    uint depthRT3;
    uint depthRT4;
};

cbuffer OutlinePassBufferData
{
    float3 outlineColor;
    float outlineWidth;
};

struct PSInput 
{ 
    float4 Pos : SV_POSITION;
    float2 UV  : TEX_COORD; 
};

struct PSOutput
{
    float4 Color : SV_TARGET;
};

static float nearClip = 0.1f;
static float farClip = 400.0f;

float SampleNormalizeDepth(Texture2D tex, SamplerState smplr, float2 uv)
{
    float rawDepth = tex.Sample(smplr, uv).r;
    float3 ndc = float3(uv * 2.0 - 1.0, rawDepth);
    float4 view = cameraInvProjection * float4(ndc, 1.0);
    view.xyz /= view.w;
    float linearDepth = -view.z;
    float normalizedDepth =  (linearDepth - nearClip) / (farClip - nearClip);
    return pow(normalizedDepth, 2.0f);
}

float ReadDepth(float sampledDepth)
{
    float nearClip = 0.1f;
    float farClip = 400.0f;
    float linearDepth = (2.0f * nearClip) / (farClip + nearClip - sampledDepth * (farClip - nearClip));
    return pow(linearDepth, 4.0f);
}

float SampleDepth(Texture2D tex, SamplerState texSampler, float2 uv)
{
    return ReadDepth(tex.Sample(texSampler, uv).r);
}

float Sample(Texture2D tex, SamplerState smplr, float2 uv)
{
    return tex.Sample(smplr, uv).r;
}

float2 GetKernelUV(float2 uv, float2 texel,  float2 kernelCoord)
{
    return uv + texel * kernelCoord;
}

static float3x3 SobelXKernel = {1,  0, -1,
                                2,  0, -2,
                                1,  0, -1};

static float3x3 SobelYKernel = {1,  2,  1,
                                0,  0,  0,
                               -1, -2, -1};

float DepthOutline(Texture2D tex, SamplerState smplr, float2 uv, float screenWidth, float screenHeight, float inOutlineWidth)
{
    float2 texel = float2(1.0f / screenWidth, 1.0f / screenHeight) * inOutlineWidth; // Dimensions of a single texel in the image

    // Build the kernel (a 3x3 grid of texels, the 8 texels surrounding the current texel and the current texel)
    float t00 = SampleDepth(tex, smplr, GetKernelUV(uv, texel, float2(-1,  1)));
    float t01 = SampleDepth(tex, smplr, GetKernelUV(uv, texel, float2(-1,  0)));
    float t02 = SampleDepth(tex, smplr, GetKernelUV(uv, texel, float2(-1, -1)));
    float t10 = SampleDepth(tex, smplr, GetKernelUV(uv, texel, float2( 0, -1)));
    float t11 = SampleDepth(tex, smplr, GetKernelUV(uv, texel, float2( 0,  0)));
    float t12 = SampleDepth(tex, smplr, GetKernelUV(uv, texel, float2( 0,  1)));
    float t20 = SampleDepth(tex, smplr, GetKernelUV(uv, texel, float2( 1, -1)));
    float t21 = SampleDepth(tex, smplr, GetKernelUV(uv, texel, float2( 1,  0)));
    float t22 = SampleDepth(tex, smplr, GetKernelUV(uv, texel, float2( 1,  1)));
    
    // Apply the Sobel X and Sobel Y kernels to the kernel
    float xSobelValue = SobelXKernel[0][0] * t00 + SobelXKernel[0][1] * t01 + SobelXKernel[0][2] * t02 +
                        SobelXKernel[1][0] * t10 + SobelXKernel[1][1] * t11 + SobelXKernel[1][2] * t12 +
                        SobelXKernel[2][0] * t20 + SobelXKernel[2][1] * t21 + SobelXKernel[2][2] * t22;

    float ySobelValue = SobelYKernel[0][0] * t00 + SobelYKernel[0][1] * t01 + SobelYKernel[0][2] * t02 +
                        SobelYKernel[1][0] * t10 + SobelYKernel[1][1] * t11 + SobelYKernel[1][2] * t12 +
                        SobelYKernel[2][0] * t20 + SobelYKernel[2][1] * t21 + SobelYKernel[2][2] * t22;

    return sqrt(xSobelValue * xSobelValue + ySobelValue * ySobelValue);
}

static float lowThreshold = 0.008f;     // Suppress weak edges
static float highThreshold = 0.025f;     // Detect strong edges
static float edgeExponent = 1.5f;      // Emphasize edges non-linearly

float NormalOutline(Texture2D tex, SamplerState smplr, float2 uv, float screenWidth, float screenHeight, float inOutlineWidth)
{
    float2 texel = float2(1.0f / screenWidth, 1.0f / screenHeight) * inOutlineWidth;

    // Kernel sampling
    float t00 = Sample(tex, smplr, GetKernelUV(uv, texel, float2(-1,  1)));
    float t01 = Sample(tex, smplr, GetKernelUV(uv, texel, float2(-1,  0)));
    float t02 = Sample(tex, smplr, GetKernelUV(uv, texel, float2(-1, -1)));
    float t10 = Sample(tex, smplr, GetKernelUV(uv, texel, float2( 0, -1)));
    float t11 = Sample(tex, smplr, GetKernelUV(uv, texel, float2( 0,  0)));
    float t12 = Sample(tex, smplr, GetKernelUV(uv, texel, float2( 0,  1)));
    float t20 = Sample(tex, smplr, GetKernelUV(uv, texel, float2( 1, -1)));
    float t21 = Sample(tex, smplr, GetKernelUV(uv, texel, float2( 1,  0)));
    float t22 = Sample(tex, smplr, GetKernelUV(uv, texel, float2( 1,  1)));

    // Apply Sobel kernels to compute gradients
    float xGradient = t00 + 2.0 * t01 + t02 - (t20 + 2.0 * t21 + t22);
    float yGradient = t00 + 2.0 * t10 + t20 - (t02 + 2.0 * t12 + t22);

    // Edge magnitude
    float edgeMagnitude = sqrt(xGradient * xGradient + yGradient * yGradient);

    // Suppress noise and weak edges
    float filteredEdge = smoothstep(lowThreshold, highThreshold, edgeMagnitude);

    // Apply non-linear scaling and intensity
    filteredEdge = pow(filteredEdge * 1.5, edgeExponent);

    return saturate(filteredEdge);
}

void main(in PSInput PSIn, out PSOutput PSOut)
{
    // Get screen dimensions
    uint screenWidth, screenHeight;
    PostProcessColorSinkBufferData[colorRT1].GetDimensions(screenWidth, screenHeight);

    // Get normalized depth. Use this transform the outline width to scale with depth, so it isn't fixed with the screen size.
    // (We don't want a consistent 20 pixel outline when we are far away and when we're really close, for example.)
    float normalizedDepth = SampleNormalizeDepth(PostProcessDepthSinkBufferData[depthRT1], PostProcessColorSinkBufferData_sampler, PSIn.UV);
    float depthNormalizedOutlineWidth = outlineWidth / 150 * 1/normalizedDepth;

    float depthOutline = DepthOutline(PostProcessDepthSinkBufferData[depthRT1],
                                      PostProcessColorSinkBufferData_sampler,
                                      PSIn.UV,
                                      screenWidth,
                                      screenHeight,
                                      depthNormalizedOutlineWidth);

    float normalOutline = NormalOutline(PostProcessColorSinkBufferData[colorRT2],
                                        PostProcessColorSinkBufferData_sampler,
                                        PSIn.UV,
                                        screenWidth,
                                        screenHeight,
                                        depthNormalizedOutlineWidth);

    float outline = (depthOutline + normalOutline);

    float4 Color = PostProcessColorSinkBufferData[colorRT1].Sample(PostProcessColorSinkBufferData_sampler, PSIn.UV);
    PSOut.Color = lerp(Color, float4(outlineColor, 1.0f), normalOutline);
    PSOut.Color.a = 1.0;

    // PSOut.Color = float4(normalizedDepth);
}
