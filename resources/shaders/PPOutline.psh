#ifdef VULKAN
// NonUniformResourceIndex is not supported by GLSLang
#   define NonUniformResourceIndex(x) x
#endif

Texture2D     PostProcessColorSinkBufferData[];
Texture2D     PostProcessDepthSinkBufferData[];
SamplerState  PostProcessColorSinkBufferData_sampler; // By convention, texture samplers must use the '_sampler' suffix

cbuffer PostProcessSinkIndexBufferData
{
    uint colorRT1;
    uint colorRT2;
    uint colorRT3;
    uint colorRT4;
    uint depthRT1;
    uint depthRT2;
    uint depthRT3;
    uint depthRT4;
};

cbuffer OutlinePassBufferData
{
    float3 outlineColor;
    float outlineWidth;
};

struct PSInput 
{ 
    float4 Pos : SV_POSITION;
    float2 UV  : TEX_COORD; 
};

struct PSOutput
{
    float4 Color : SV_TARGET;
};

float ReadDepth(float sampledDepth)
{
    float nearClip = 0.1f;
    float farClip = 400.0f;
    float linearDepth = (2.0f * nearClip) / (farClip + nearClip - sampledDepth * (farClip - nearClip));
    return pow(linearDepth, 2.0f);
}

float ReadNormal(float3 sampledNormal)
{
    float3 magic = float3(0.2125f, 0.7154f, 0.0721f);
    return dot(magic, sampledNormal);
}

float SampleDepth(Texture2D tex, SamplerState texSampler, float2 uv)
{
    return ReadDepth(tex.Sample(texSampler, uv).r);
}

float SampleNormal(Texture2D tex, SamplerState texSampler, float2 uv)
{
    return ReadNormal(tex.Sample(texSampler, uv));
}

float2 GetKernelUV(float2 uv, float2 texel, float outlineWidth, float2 kernelCoord)
{
    return uv + outlineWidth * texel * kernelCoord;
}

static float3x3 SobelXKernel = {1,  0, -1,
                                2,  0, -2,
                                1,  0, -1};

static float3x3 SobelYKernel = {1,  2,  1,
                                0,  0,  0,
                               -1, -2, -1};

float DepthOutline(Texture2D tex, SamplerState texSampler, float2 uv, float screenWidth, float screenHeight, float outlineWidth)
{
    float2 texel = float2(1.0f / screenWidth, 1.0f / screenHeight); // Dimensions of a single texel in the image

    // Kernel
    float t00, t01, t02;
    float t10, t11, t12;
    float t20, t21, t22;

    // Build the kernel (a 3x3 grid of texels, the 8 texels surrounding the current texel and the current texel)
    t00 = SampleDepth(tex, texSampler, GetKernelUV(uv, texel, outlineWidth, float2(-1,  1)));
    t01 = SampleDepth(tex, texSampler, GetKernelUV(uv, texel, outlineWidth, float2(-1,  0)));
    t02 = SampleDepth(tex, texSampler, GetKernelUV(uv, texel, outlineWidth, float2(-1, -1)));

    t10 = SampleDepth(tex, texSampler, GetKernelUV(uv, texel, outlineWidth, float2( 0, -1)));
    t11 = SampleDepth(tex, texSampler, GetKernelUV(uv, texel, outlineWidth, float2( 0,  0)));
    t12 = SampleDepth(tex, texSampler, GetKernelUV(uv, texel, outlineWidth, float2( 0,  1)));

    t20 = SampleDepth(tex, texSampler, GetKernelUV(uv, texel, outlineWidth, float2( 1, -1)));
    t21 = SampleDepth(tex, texSampler, GetKernelUV(uv, texel, outlineWidth, float2( 1,  0)));
    t22 = SampleDepth(tex, texSampler, GetKernelUV(uv, texel, outlineWidth, float2( 1,  1)));
    
    // Apply the Sobel X and Sobel Y kernels to the kernel
    float xSobelValue = SobelXKernel[0][0] * t00 + SobelXKernel[0][1] * t01 + SobelXKernel[0][2] * t02 +
                        SobelXKernel[1][0] * t10 + SobelXKernel[1][1] * t11 + SobelXKernel[1][2] * t12 +
                        SobelXKernel[2][0] * t20 + SobelXKernel[2][1] * t21 + SobelXKernel[2][2] * t22;

    float ySobelValue = SobelYKernel[0][0] * t00 + SobelYKernel[0][1] * t01 + SobelYKernel[0][2] * t02 +
                        SobelYKernel[1][0] * t10 + SobelYKernel[1][1] * t11 + SobelYKernel[1][2] * t12 +
                        SobelYKernel[2][0] * t20 + SobelYKernel[2][1] * t21 + SobelYKernel[2][2] * t22;

    return sqrt(xSobelValue * xSobelValue + ySobelValue * ySobelValue);
}

static float lowThreshold = 0.023f;     // Suppress weak edges
static float highThreshold = 0.025f;     // Detect strong edges
static float edgeExponent = 1.0f;      // Emphasize edges non-linearly

float NormalOutline(Texture2D tex, SamplerState texSampler, float2 uv, float screenWidth, float screenHeight, float outlineWidth)
{
    float2 texel = float2(1.0f / screenWidth, 1.0f / screenHeight);

    // Sample center normal (used for comparison)
    float centerNormal = SampleNormal(tex, texSampler, uv);

    // Kernel sampling
    float t00 = abs(SampleNormal(tex, texSampler, GetKernelUV(uv, texel, outlineWidth, float2(-1,  1))) - centerNormal);
    float t01 = abs(SampleNormal(tex, texSampler, GetKernelUV(uv, texel, outlineWidth, float2(-1,  0))) - centerNormal);
    float t02 = abs(SampleNormal(tex, texSampler, GetKernelUV(uv, texel, outlineWidth, float2(-1, -1))) - centerNormal);

    float t10 = abs(SampleNormal(tex, texSampler, GetKernelUV(uv, texel, outlineWidth, float2( 0, -1))) - centerNormal);
    float t11 = 0.0; // Center texel already handled
    float t12 = abs(SampleNormal(tex, texSampler, GetKernelUV(uv, texel, outlineWidth, float2( 0,  1))) - centerNormal);

    float t20 = abs(SampleNormal(tex, texSampler, GetKernelUV(uv, texel, outlineWidth, float2( 1, -1))) - centerNormal);
    float t21 = abs(SampleNormal(tex, texSampler, GetKernelUV(uv, texel, outlineWidth, float2( 1,  0))) - centerNormal);
    float t22 = abs(SampleNormal(tex, texSampler, GetKernelUV(uv, texel, outlineWidth, float2( 1,  1))) - centerNormal);

    // Apply Sobel kernels to compute gradients
    float xGradient = t00 + 2.0 * t01 + t02 - (t20 + 2.0 * t21 + t22);
    float yGradient = t00 + 2.0 * t10 + t20 - (t02 + 2.0 * t12 + t22);

    // Edge magnitude
    float edgeMagnitude = sqrt(xGradient * xGradient + yGradient * yGradient);

    // Suppress noise and weak edges
    float filteredEdge = smoothstep(lowThreshold, highThreshold, edgeMagnitude);

    // Apply non-linear scaling and intensity
    filteredEdge = pow(filteredEdge, edgeExponent);

    return saturate(filteredEdge);
}

void main(in PSInput PSIn, out PSOutput PSOut)
{
    uint screenWidth, screenHeight;
    PostProcessColorSinkBufferData[colorRT1].GetDimensions(screenWidth, screenHeight);
    float4 Color = PostProcessColorSinkBufferData[colorRT1].Sample(PostProcessColorSinkBufferData_sampler, PSIn.UV);
    float4 Normals = PostProcessColorSinkBufferData[colorRT2].Sample(PostProcessColorSinkBufferData_sampler, PSIn.UV);

    float depthOutline = DepthOutline(PostProcessDepthSinkBufferData[depthRT1],
                                      PostProcessColorSinkBufferData_sampler,
                                      PSIn.UV,
                                      screenWidth,
                                      screenHeight,
                                      outlineWidth);

    float normalOutline = NormalOutline(PostProcessColorSinkBufferData[colorRT2],
                                        PostProcessColorSinkBufferData_sampler,
                                        PSIn.UV,
                                        screenWidth,
                                        screenHeight,
                                        outlineWidth);

    float outline = depthOutline  + normalOutline;

    PSOut.Color = lerp(Color, float4(outlineColor, 1.0f), outline);
    PSOut.Color.a = 1.0;
}
