#ifdef VULKAN
// NonUniformResourceIndex is not supported by GLSLang
#   define NonUniformResourceIndex(x) x
#endif

Texture2D     PostProcessColorSinkBufferData[];
Texture2D     PostProcessDepthSinkBufferData[];
SamplerState  PostProcessColorSinkBufferData_sampler; // By convention, texture samplers must use the '_sampler' suffix

cbuffer EnvironmentBufferData
{
    float4x4 cameraViewProjection;
    float4x4 cameraInvProjection;
    float3 cameraPosition;
    uint lightCount;
};

cbuffer PostProcessSinkIndexBufferData
{
    uint colorRT1;
    uint colorRT2;
    uint colorRT3;
    uint colorRT4;
    uint depthRT1;
    uint depthRT2;
    uint depthRT3;
    uint depthRT4;
};

cbuffer OutlinePassBufferData
{
    float3 outlineColor;
    float outlineWidth;
};

struct PSInput 
{ 
    float4 Pos : SV_POSITION;
    float2 UV  : TEX_COORD; 
};

struct PSOutput
{
    float4 Color : SV_TARGET;
};

static float nearClip = 0.1f;
static float farClip = 400.0f;

float SampleNormalizeDepth(Texture2D tex, SamplerState smplr, float2 uv)
{
    float rawDepth = tex.Sample(smplr, uv).r;
    float3 ndc = float3(uv * 2.0 - 1.0, rawDepth);
    float4 view = cameraInvProjection * float4(ndc, 1.0);
    view.xyz /= view.w;
    float linearDepth = -view.z;
    float normalizedDepth =  (linearDepth - nearClip) / (farClip - nearClip);
    return (linearDepth - nearClip) / (farClip - nearClip);
}

static float depthThreshold = 0.8f;
// Credit to: https://roystan.net/articles/outline-shader/

float OutlineDepth(Texture2D depthTex, SamplerState smplr, float2 LLUV, float2 URUV, float2 LRUV, float2 ULUV)
{
    // Sample depth texture at four corners
    float depthLL = SampleNormalizeDepth(depthTex, smplr, LLUV);
    float depthUR = SampleNormalizeDepth(depthTex, smplr, URUV);
    float depthLR = SampleNormalizeDepth(depthTex, smplr, LRUV);
    float depthUL = SampleNormalizeDepth(depthTex, smplr, ULUV);

    float depthDiagDif0 = abs((depthUR - depthLL) * 100);
    float depthDiagDif1 = abs((depthUL - depthLR) * 100);
    float depthEdge = sqrt(pow(depthDiagDif0, 2) + pow(depthDiagDif1, 2));
    //

    // Modulate depthThreshold by depth
    depthThreshold = depthThreshold * depthLL;
    depthEdge = depthEdge > depthThreshold ? 1.0f : 0.0f;

    return depthEdge;
}

static float normalsThreshold = 0.4f;
float OutlineNormals(Texture2D normalsTex, SamplerState smplr, float2 LLUV, float2 URUV, float2 LRUV, float2 ULUV)
{
    // Sample normals texture at four corners
    float3 normalsLL = normalsTex.Sample(smplr, LLUV);
    float3 normalsUR = normalsTex.Sample(smplr, URUV);
    float3 normalsLR = normalsTex.Sample(smplr, LRUV);
    float3 normalsUL = normalsTex.Sample(smplr, ULUV);

    float3 normalsDiagDif0 = (normalsUR - normalsLL) * 2;
    float3 normalsDiagDif1 = (normalsUL - normalsLR) * 2;
    float normalsEdge = sqrt(dot(normalsDiagDif0, normalsDiagDif0) + dot(normalsDiagDif1, normalsDiagDif1));

    normalsEdge = normalsEdge > normalsThreshold ? 1.0f : 0.0f;
    return normalsEdge;
}

void main(in PSInput PSIn, out PSOutput PSOut)
{
    // Get screen dimensions
    uint screenWidth, screenHeight;
    PostProcessColorSinkBufferData[colorRT1].GetDimensions(screenWidth, screenHeight);
    float2 texelSize = float2(1.0 / screenWidth, 1.0 / screenHeight); // 1/1600, 1/900

    float outlineWidthHalfFloor = floor(outlineWidth * 0.5); // floor(1 * 0.5) = 0
    float outlineWidthHalfCeil = ceil(outlineWidth * 0.5); // ceil(1 * 0.5) = 1

    // Get UV coords for four pixels in a 'four corners' shape surrounding the current texel
    float2 LLUV = PSIn.UV - float2(texelSize.x, texelSize.y) * outlineWidthHalfFloor; // eg. (.2, .7) - ((1px, 1px) * 0)                             = (.2,       .7)
    float2 URUV = PSIn.UV + float2(texelSize.x, texelSize.y) * outlineWidthHalfCeil; // eg. (.2, .7) + ((1px, 1px) * 1)                              = (.2 + 1px, .7 + 1px)
    float2 LRUV = PSIn.UV + float2(texelSize.x * outlineWidthHalfCeil, -texelSize.y * outlineWidthHalfFloor); // eg. (.2, .7) + (1px * 1, -1px * 0)  = (.2 + 1px, .7)
    float2 ULUV = PSIn.UV + float2(-texelSize.x * outlineWidthHalfFloor, texelSize.y * outlineWidthHalfCeil); // eg. (.2, .7) + (-1px * 0, 1px * 1)  = (.2, .7 + 1px)
    
    // float3 normalsTex = PostProcessColorSinkBufferData[colorRT2].Sample(PostProcessColorSinkBufferData_sampler, PSIn.UV);
    // float3 viewNormal = normalsTex * 2.0 - 1;
    // float NDotV = 1 - dot(viewNormal, -)

    float depthEdge = OutlineDepth(PostProcessDepthSinkBufferData[depthRT1],
                                   PostProcessColorSinkBufferData_sampler,
                                   LLUV, URUV, LRUV, ULUV);
    
    float normalsEdge = OutlineNormals(PostProcessColorSinkBufferData[colorRT2],
                                       PostProcessColorSinkBufferData_sampler,
                                       LLUV, URUV, LRUV, ULUV);

    float edge = max(normalsEdge, depthEdge);
    float4 sceneColor = PostProcessColorSinkBufferData[colorRT1].Sample(PostProcessColorSinkBufferData_sampler, PSIn.UV);
    PSOut.Color = lerp(sceneColor, float4(outlineColor, 1.0f), edge);
}
