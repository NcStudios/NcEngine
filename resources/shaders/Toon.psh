#ifdef VULKAN
// NonUniformResourceIndex is not supported by GLSLang
#   define NonUniformResourceIndex(x) x
#endif

#include "Lighting.fxh"

Texture2D     Textures[];
SamplerState  Textures_sampler; // By convention, texture samplers must use the '_sampler' suffix

cbuffer EnvironmentProperties
{
    float4x4 cameraViewProjection;
    float4x4 cameraInvProjection;
    float3 cameraPosition;
    uint lightCount;
    float nearClip;
    float farClip;
};

struct MaterialData
{
    uint diffuseTexIndex;
    uint normalTexIndex;
    uint hatchTexIndex;
    float normalIntensity;
    float hatchTiling;
    float padding;
    float padding1;
    float padding2;
};

StructuredBuffer<MaterialData> Materials : register(t1);
StructuredBuffer<LightData> Lights : register(t2);

struct PSInput 
{ 
    float4 Pos           : SV_POSITION;
    float3 Normal        : NORMAL;
    float2 UV            : TEX_COORD; 
    uint   MaterialIndex;
    float3 WorldPos;
};

struct PSOutput
{
    float4 Color : SV_TARGET;
};

const float Epsilon = 1e-10;

float3 RGBtoHSV(in float3 RGB)
{
    float4 P = (RGB.g < RGB.b) ? float4(RGB.bg, -1.0, 2.0/3.0) : float4(RGB.gb, 0.0, -1.0/3.0);
    float4 Q = (RGB.r < P.x) ? float4(P.xyw, RGB.r) : float4(RGB.r, P.yzx);
    float C = Q.x - min(Q.w, Q.y);
    float H = abs((Q.w - Q.y) / (6.0 * C + Epsilon) + Q.z);
    float3 HCV = float3(H, C, Q.x);
    float S = HCV.y / (HCV.z + Epsilon);
    return float3(HCV.x, S, HCV.z);
}

float3 HSVtoRGB(in float3 HSV)
{
    float H = HSV.x;
    float R = abs(H * 6.0 - 3.0) - 1.0;
    float G = 2.0 - abs(H * 6.0 - 2.0);
    float B = 2.0 - abs(H * 6.0 - 4.0);
    float3 RGB = clamp( float3(R,G,B), 0.0, 1.0 );
    return ((RGB - 1.0) * HSV.y + 1.0) * HSV.z;
}

float Band(float lightAmount)
{
    if (lightAmount < 0.001f)
    {
        return 0.0f;
    }

    return 1.0f;
}

void main(in  PSInput  PSIn, out PSOutput PSOut)
{
    // Get texture color
    uint TexIndex = Materials[PSIn.MaterialIndex].diffuseTexIndex;
    uint NormalIndex = Materials[PSIn.MaterialIndex].normalTexIndex;
    float4 Color = Textures[TexIndex].Sample(Textures_sampler, PSIn.UV);
    float4 Normals = Textures[NormalIndex].Sample(Textures_sampler, PSIn.UV);

    // Get hatching texture and tiling property
    uint hatchTexIndex = Materials[PSIn.MaterialIndex].hatchTexIndex;
    float hatchTiling  = Materials[PSIn.MaterialIndex].hatchTiling;
    float hatchLight   = Textures[hatchTexIndex].Sample(Textures_sampler, PSIn.UV * hatchTiling).r;
    float hatchMedium  = Textures[hatchTexIndex].Sample(Textures_sampler, PSIn.UV * hatchTiling).g;
    float hatchDark    = Textures[hatchTexIndex].Sample(Textures_sampler, PSIn.UV * hatchTiling).b;

    // Get normals either from vertex normals or from the normal texture
    float3 normals = PSIn.Normal;
    if (hatchTiling > 1.0f) //@todo : Parameterize
    {
        normals = normalize(Normals.xyz * float3(2.0) - float3(1.0));
    }

    float3 result = 0.0f;
    float diffuseAmt = 0.0f;
    float specularAmt = 0.0f;
    float3 diffuseCol = float3(0.0f);
    float3 specularCol = float3(0.0f);
    float intensity = 1.0f;

    for (int i = 0; i < lightCount; i++)
    {
        LightInfluence influence = LightRadiance(Lights[i], PSIn.WorldPos, cameraPosition, normals);

        diffuseAmt += influence.diffuseAmt;
        specularAmt += influence.specularAmt;
        diffuseCol += influence.diffuseColor;
        specularCol += influence.specularColor;
        intensity = max(intensity, influence.intensity);
    }

    // Apply light banding
    float bandedDiffuseAmt = Band(diffuseAmt) * intensity;
    float bandedSpecularAmt = Band(specularAmt) * intensity;

    result += (bandedDiffuseAmt * diffuseCol * Color.rgb + bandedSpecularAmt * specularCol * Color.rgb);

    // Apply hatching
    if (diffuseAmt < 0.05f)
    {
        result.rgb = result.rgb * hatchDark;
    }
    else if (diffuseAmt < 0.1f)
    {
        result.rgb = result.rgb * hatchMedium;
    }

    float3 colHsv = RGBtoHSV(float3(result.r, result.g, result.b));
    colHsv.y *= (1.25f);
    colHsv.z *= (1.25f);
    result.rgb = HSVtoRGB(colHsv.rgb);

    PSOut.Color = float4(result, 1.0f);
}
