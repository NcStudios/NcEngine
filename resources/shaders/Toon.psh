#ifdef VULKAN
// NonUniformResourceIndex is not supported by GLSLang
#   define NonUniformResourceIndex(x) x
#endif

#include "Lighting.fxh"

Texture2D     TextureBufferData[];
SamplerState  TextureBufferData_sampler; // By convention, texture samplers must use the '_sampler' suffix

cbuffer EnvironmentBufferData
{
    float4x4 cameraViewProjection;
    float4x4 cameraInvProjection;
    float3 cameraPosition;
    uint lightCount;
    float nearClip;
    float farClip;
};

struct MaterialData
{
    float3 gradientStart;
    uint diffuseTexture;
    float3 gradientEnd;
    uint hatchingIndex;
    float normalIntensity;
    float hatchingTiling;
    float padding2;
    float padding3;
};

StructuredBuffer<MaterialData> MaterialBufferData : register(t1);
StructuredBuffer<LightData> LightBufferData : register(t2);

struct PSInput 
{ 
    float4 Pos           : SV_POSITION;
    float3 Normal        : NORMAL;
    float2 UV            : TEX_COORD; 
    uint   MaterialIndex;
    float3 WorldPos;
};

struct PSOutput
{
    float4 Color : SV_TARGET;
};

float LightBand(float lightAmount)
{
    // Define the range for the soft transition
    float lowerEdge = 0.095; // Start of the soft blend
    float upperEdge = 0.1; // End of the soft blend

    // Smoothly blend between the two bands
    float blendFactor = smoothstep(lowerEdge, upperEdge, lightAmount);

    // Define the values for the bands
    float bandLow = 0.1;
    float bandHigh = 1.0;

    // Interpolate between the two bands
    return lerp(bandLow, bandHigh, blendFactor);
}

void main(in  PSInput  PSIn, out PSOutput PSOut)
{
    float4 Color;
    uint TexIndex = MaterialBufferData[PSIn.MaterialIndex].diffuseTexture;
    Color = TextureBufferData[TexIndex].Sample(TextureBufferData_sampler, PSIn.UV);
    float alpha = Color.a;
    float3 finalColor = {0.0f, 0.0f, 0.0f};

    float hatchingTiling = MaterialBufferData[PSIn.MaterialIndex].hatchingTiling;
    uint hatchingIndex = MaterialBufferData[PSIn.MaterialIndex].hatchingIndex;
    float hatchLight  = TextureBufferData[hatchingIndex].Sample(TextureBufferData_sampler, PSIn.UV * hatchingTiling).r;
    float hatchMedium = TextureBufferData[hatchingIndex].Sample(TextureBufferData_sampler, PSIn.UV * hatchingTiling).g;
    float hatchDark   = TextureBufferData[hatchingIndex].Sample(TextureBufferData_sampler, PSIn.UV * hatchingTiling).b;

    float lightAmountTotal = 0.0f;

    for (int i = 0; i < lightCount; i++)
    {
        LightInfluence influence = LightRadiance(LightBufferData[i], PSIn.WorldPos, cameraPosition, PSIn.Normal);
        finalColor += influence.diffuseColor * LightBand(influence.diffuseAmt) + influence.specularColor * LightBand(influence.specularAmt);
        lightAmountTotal += influence.diffuseAmt + influence.specularAmt;
    }

    if (lightAmountTotal < 0.05f)
    {
        Color *= 0.05f;
    }
    else if (lightAmountTotal < 0.2f)
    {
        float blend = smoothstep(0.05f, 0.2f, lightAmountTotal);
        Color *= lerp(0.05f, hatchMedium, blend);
    }
    else if (lightAmountTotal < 0.45f)
    {
        float blend = smoothstep(0.2f, 0.5f, lightAmountTotal);
        Color *= lerp(hatchMedium, hatchLight, blend);
    }

    Color *= float4(finalColor, 1.0);
    Color.a = alpha;
    PSOut.Color = Color;
}
