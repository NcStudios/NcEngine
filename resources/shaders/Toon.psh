#ifdef VULKAN
// NonUniformResourceIndex is not supported by GLSLang
#   define NonUniformResourceIndex(x) x
#endif

#include "Lighting.fxh"

Texture2D     Textures[];
SamplerState  Textures_sampler; // By convention, texture samplers must use the '_sampler' suffix

cbuffer EnvironmentProperties
{
    float4x4 cameraViewProjection;
    float4x4 cameraInvProjection;
    float3 cameraPosition;
    uint lightCount;
    float nearClip;
    float farClip;
};

struct MaterialData
{
    uint diffuseTexIndex;
    uint normalTexIndex;
    uint hatchTexIndex;
    float normalIntensity;
    float hatchTiling;
    float padding;
    float padding1;
    float padding2;
};

StructuredBuffer<MaterialData> Materials : register(t1);
StructuredBuffer<LightData> Lights : register(t2);

struct PSInput 
{ 
    float4 Pos           : SV_POSITION;
    float3 Normal        : NORMAL;
    float2 UV            : TEX_COORD; 
    uint   MaterialIndex;
    float3 WorldPos;
};

struct PSOutput
{
    float4 Color : SV_TARGET;
};

const float Epsilon = 1e-10;

float3 RGBtoHSV(in float3 RGB)
{
    float4 P = (RGB.g < RGB.b) ? float4(RGB.bg, -1.0, 2.0/3.0) : float4(RGB.gb, 0.0, -1.0/3.0);
    float4 Q = (RGB.r < P.x) ? float4(P.xyw, RGB.r) : float4(RGB.r, P.yzx);
    float C = Q.x - min(Q.w, Q.y);
    float H = abs((Q.w - Q.y) / (6.0 * C + Epsilon) + Q.z);
    float3 HCV = float3(H, C, Q.x);
    float S = HCV.y / (HCV.z + Epsilon);
    return float3(HCV.x, S, HCV.z);
}

float3 HSVtoRGB(in float3 HSV)
{
    float H = HSV.x;
    float R = abs(H * 6.0 - 3.0) - 1.0;
    float G = 2.0 - abs(H * 6.0 - 2.0);
    float B = 2.0 - abs(H * 6.0 - 4.0);
    float3 RGB = clamp( float3(R,G,B), 0.0, 1.0 );
    return ((RGB - 1.0) * HSV.y + 1.0) * HSV.z;
}

void main(in  PSInput  PSIn, out PSOutput PSOut)
{
    // Get texture color
    uint TexIndex = Materials[PSIn.MaterialIndex].diffuseTexIndex;
    float4 Color = Textures[TexIndex].Sample(Textures_sampler, PSIn.UV);

    // Get hatching texture and tiling property
    uint hatchTexIndex = Materials[PSIn.MaterialIndex].hatchTexIndex;
    float hatchTiling  = Materials[PSIn.MaterialIndex].hatchTiling;
    float hatchLight   = Textures[hatchTexIndex].Sample(Textures_sampler, PSIn.UV * hatchTiling).r;
    float hatchMedium  = Textures[hatchTexIndex].Sample(Textures_sampler, PSIn.UV * hatchTiling).g;
    float hatchDark    = Textures[hatchTexIndex].Sample(Textures_sampler, PSIn.UV * hatchTiling).b;

    float3 light = float3(0.0f);
    float3 combinedDiffuseColor = float3(0.0f);
    float combinedDiffuseAmt = 0.0f;
    float3 combinedSpecularColor = float3(0.0f);
    float combinedSpecularAmount = 0.0f;
    float3 combinedShadowColor = 0.0f;

    for (int i = 0; i < lightCount; i++)
    {
        LightInfluence influence = LightRadiance(Lights[i], PSIn.WorldPos, cameraPosition, PSIn.Normal);

        combinedDiffuseColor += influence.diffuseColor;
        combinedDiffuseAmt += influence.diffuseAmt;
        combinedSpecularColor += influence.specularColor;
        combinedSpecularAmount += influence.specularAmt;
        combinedShadowColor += influence.shadowColor;
    }

    // Light banding (specular, shadow, diffuse)
    float diffuseBlendFactor = smoothstep(0.00f, 0.1f, combinedDiffuseAmt);
    float specularBlendFactor = smoothstep(0.8f, 1.0f, combinedDiffuseAmt);
    float3 blendedDiffuse = lerp((combinedShadowColor), combinedDiffuseColor, diffuseBlendFactor);
    float3 blendedSpecular = lerp(combinedDiffuseColor, combinedSpecularColor, specularBlendFactor);
    light += lerp(blendedDiffuse, blendedSpecular, specularBlendFactor);
    Color.rgb *= light;

    // Light banding (hatching)
    if (combinedDiffuseAmt < 0.1f)
    {
        Color.rbg = Color.rbg * hatchMedium;
    }
    else if (combinedDiffuseAmt < 0.3f)
    {
        Color.rbg = Color.rbg * hatchLight;
    }

    float3 colHsv = RGBtoHSV(float3(Color.r, Color.g, Color.b));
    colHsv.y *= (1.25f);
    colHsv.z *= (1.25f);
    Color.rgb = HSVtoRGB(colHsv.rgb);

    PSOut.Color = Color * 2.0f;
}
