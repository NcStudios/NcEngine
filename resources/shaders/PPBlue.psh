#ifdef VULKAN
// NonUniformResourceIndex is not supported by GLSLang
#   define NonUniformResourceIndex(x) x
#endif

Texture2D     PostProcessSinkBufferData[];
SamplerState  PostProcessSinkBufferData_sampler; // By convention, texture samplers must use the '_sampler' suffix

cbuffer PostProcessSinkIndexBufferData
{
    uint colorRT1;
    uint colorRT2;
    uint colorRT3;
    uint colorRT4;
    uint depthRT1;
    uint depthRT2;
    uint depthRT3;
    uint depthRT4;
};

struct PSInput 
{ 
    float4 Pos : SV_POSITION;
    float2 UV  : TEX_COORD; 
};

struct PSOutput
{
    float4 Color : SV_TARGET;
};

void main(in PSInput PSIn, out PSOutput PSOut)
{
    float4 Color = PostProcessSinkBufferData[colorRT1].Sample(PostProcessSinkBufferData_sampler, PSIn.UV);
    Color += float4(0.0, 0.0, 0.2, 0.0);
    PSOut.Color = Color;
}
