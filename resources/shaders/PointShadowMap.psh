#include "Lighting.fxh"

struct VSInput
{
    // Vertex attributes
    float3 Pos    : ATTRIB0;
    float3 Normal : ATTRIB1;
    float2 UV     : ATTRIB2;
};

struct PSInput 
{
    float4 Pos : SV_POSITION;
    float4 WorldPos;
    float ZDepth;
};

struct PSOutput
{
    float4 Color : SV_TARGET;
};

struct TransformData
{
    float4x4 model;
};

StructuredBuffer<TransformData> Transforms;
StructuredBuffer<LightData> Lights;

struct StaticMeshInstanceData
{
    uint transformIndex;
    uint materialIndex;
};

StructuredBuffer<StaticMeshInstanceData> StaticInstances;

cbuffer SinkIndices
{
    int colorRT1;
    int colorRT2;
    int colorRT3;
    int colorRT4;
    int depthRT1;
    int depthRT2;
    int depthRT3;
    uint hasPostProcess;
    uint lightIndex;
    uint lightFaceIndex;
};

void main(in PSInput PSIn, out PSOutput PSOut)
{
    float3 lightVec = PSIn.WorldPos.xyz - Lights[lightIndex].position;
    PSOut.Color = length(lightVec);
}