#include "core/PerFrameTypes.fxh"
#include "core/Lighting.fxh"

struct PSInput
{
    float4 Pos           : SV_POSITION;
    float3 Normal        : NORMAL;
    float2 UV            : TEX_COORD;
    uint   MaterialIndex : MAT_INDEX;
    float4 WorldPos      : WORLD_POS;
    float3 LocalPos      : LOCAL_POS;
    float3 ViewDir       : VIEW_DIR;
};

struct PSOutput
{
    float4 color : SV_TARGET;
};

Texture2D     Textures[];
SamplerState  Textures_sampler; // By convention, texture samplers must use the '_sampler' suffix

StructuredBuffer<MaterialData> Materials : register(t1);

float Band(float lightAmount)
{
    if (lightAmount * 100 < 0.05f)
    {
        return 0.0f;
    }

    return 1.0f;
}

void main(in  PSInput  PSIn, out PSOutput PSOut)
{
    MaterialData material = Materials[PSIn.MaterialIndex];

    // Get texture colors
    uint TexIndex = NonUniformResourceIndex(material.diffuseTexIndex);
    uint NormalIndex = NonUniformResourceIndex(material.normalTexIndex);
    float4 Diffuse = Textures[TexIndex].Sample(Textures_sampler, PSIn.UV);
    float4 Normals = Textures[NormalIndex].Sample(Textures_sampler, PSIn.UV);

    float4 color = Diffuse;

    // Transform colors to limited scheme
    if (useColorOverride) // Global
    {
        if (Diffuse.r > 0.99f)
        {
            color = primaryColor;
        }
        else if (Diffuse.g > 0.99f)
        {
            color = secondaryColor;
        }
        else if (Diffuse.b > 0.99f)
        {
            color = tertiaryColor;
        }
    }

    if (material.useColorOverride) // Per Material
    {
        if (Diffuse.r > 0.99f)
        {
            color = material.primaryColor;
        }
        else if (Diffuse.g > 0.99f)
        {
            color = material.secondaryColor;
        }
        else if (Diffuse.b > 0.99f)
        {
            color = material.tertiaryColor;
        }
    }

    // Get normals either from vertex normals or from the normal texture
    float3 normals = PSIn.Normal;
    if (material.useTextureNormals)
    {
        normals = normalize(Normals.xyz * float3(2.0, 2.0, 2.0) - float3(1.0, 1.0, 1.0));
    }

    float3 result = 0.0f;
    uint uniShadowMapIndex = 0u;
    uint pointShadowMapIndex = 0u;
    uint shadowCasterCount = 0u;
    float4 litColor = float4(result, 1.0f);
    float maxLightContribution = 0.0f;

    for (int i = 0; i < lightCount; i++)
    {
        LightInfluence influence = LightRadiance(Lights[i], PSIn.WorldPos.xyz, cameraPosition, normals);
        float diffuseAmt = 0.0f;
        float specularAmt = 0.0f;

        // Flat shading
        if (!material.useFlatShading)
        {
            diffuseAmt = influence.diffuseAmt * influence.intensity;
            specularAmt = influence.specularAmt * influence.intensity * material.reflectivity;
        }
        else // Smooth shading
        {
            diffuseAmt = Band(influence.diffuseAmt) * influence.intensity;
            specularAmt = Band(influence.specularAmt) * influence.intensity * material.reflectivity;
        }

        // Calculate shadow factor
        float shadowFactor = 0.0f;
        TextureCube pointDepthTex;
        Texture2D  uniDepthTex;
        if (Lights[i].castsShadows)
        {
            if (Lights[i].type == 1)
            {
                pointDepthTex = PointShadowMapSinks[pointShadowMapIndex];
                float rawShadow = PointShadowCalculation(PSIn.WorldPos, Lights[i].position, pointDepthTex, PSIn.Normal);
                shadowFactor += (rawShadow);
                pointShadowMapIndex++;
            }
            else
            {
                uniDepthTex = UniShadowMapSinks[uniShadowMapIndex];
                float rawShadow = UniShadowCalculation(Lights[i].type == 0, mul(mul(PSIn.WorldPos, LightMatrices[Lights[i].lightMatrixIndex].viewProjection), biasMat), uniDepthTex);
                shadowFactor += (rawShadow);
                uniShadowMapIndex++;
            }
        }

        shadowFactor = 1.0f - clamp(shadowFactor, 0.0f, 1.0f);
        diffuseAmt = max(diffuseAmt * shadowFactor, 0.0f);
        maxLightContribution = max(diffuseAmt, maxLightContribution);
        specularAmt = max(specularAmt * shadowFactor, 0.0f);

        // Apply lighting influences and shadows
        result += ((diffuseAmt * influence.diffuseColor * color.rgb) + (specularAmt * influence.specularColor * color.rgb ));
        litColor = float4(result, 1.0f);

        // Apply hatching
        if (material.useHatchTexture)
        {
            // Get hatching texture and tiling property
            uint hatchTexIndex = NonUniformResourceIndex(material.hatchTexIndex);
            float hatchTiling  = material.hatchTiling;
            float hatchLight   = Textures[hatchTexIndex].Sample(Textures_sampler, PSIn.UV * hatchTiling).r;
            float hatchMedium  = Textures[hatchTexIndex].Sample(Textures_sampler, PSIn.UV * hatchTiling).g;
            float hatchDark    = Textures[hatchTexIndex].Sample(Textures_sampler, PSIn.UV * hatchTiling).b;

            if (influence.diffuseAmt < 0.05f)
            {
                litColor.rgb = lerp(litColor.rgb, litColor.rgb * hatchDark, 1-(influence.diffuseAmt));
            }
            else if (influence.diffuseAmt < 0.1f)
            {
                litColor.rgb = lerp(litColor.rgb, litColor.rgb * hatchMedium, 1-(influence.diffuseAmt * 5));
            }
        }
    }

    // Gradient
    float4 gradient = lerp(material.gradientStart, material.gradientEnd, (normalize(PSIn.LocalPos).y + 1) * 0.5);
    float4 gradientApplied = lerp(litColor, litColor * gradient, material.gradientAmount);
    float4 gradientCappedByLight = lerp(gradientApplied, gradientApplied*maxLightContribution, 0.8f);
    float4 outputColor = gradientCappedByLight;

    PSOut.color = outputColor;
    PSOut.color.a = Diffuse.a;
}
