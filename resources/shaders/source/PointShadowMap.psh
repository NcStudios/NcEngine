#include "core/PerFrameTypes.fxh"
#include "core/PerPassTypes.fxh"
#include "core/Lighting.fxh"

struct PSInput 
{
    float4 Pos : SV_POSITION;
    float4 WorldPos;
};

struct PSOutput
{
    float4 Color : SV_TARGET;
};

StructuredBuffer<TransformData> Transforms;
StructuredBuffer<StaticMeshInstanceData> StaticInstances;

void main(in PSInput PSIn, out PSOutput PSOut)
{
    LightData light = Lights[lightIndex];
    float3 lightVec = PSIn.WorldPos.xyz - light.position;
    // Normalize distance by light radius (must match Lighting.fxh PointShadowCalculation)
    PSOut.Color = length(lightVec) / light.radius;
}
