#include "core/PerFrameTypes.fxh"
#include "core/PerPassTypes.fxh"
#include "core/Lighting.fxh"

struct PSInput 
{
    float4 Pos      : SV_POSITION;
    float4 WorldPos : WORLD_POS;
};

struct PSOutput
{
    float4 Color : SV_TARGET;
};

StructuredBuffer<TransformData> Transforms;
StructuredBuffer<StaticMeshInstanceData> StaticInstances;

void main(in PSInput PSIn, out PSOutput PSOut)
{
    // Radial distance from the point light to the fragment.
    float3 lightToFragment = PSIn.WorldPos.xyz - Lights[lightIndex].position;
    float distanceToLight = length(lightToFragment);

    // Store linear radial depth in [0, 1].
    // The lighting pass must perform the exact same conversion
    // before comparing against this texture.
    float depth = saturate(distanceToLight / farZ);

    PSOut.Color = float4(depth, 0.0f, 0.0f, 1.0f);
}