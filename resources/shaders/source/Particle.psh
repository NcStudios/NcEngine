struct PSInput
{
    float4 Pos           : SV_POSITION;
    float2 UV            : TEX_COORD;
    float4 Color;
    uint TextureIndex;
};

struct PSOutput
{
    float4 Color : SV_TARGET;
};

Texture2D     Textures[];
SamplerState  Textures_sampler;

void main(in PSInput PSIn, out PSOutput PSOut)
{
    float4 tex  = Textures[PSIn.TextureIndex].Sample(Textures_sampler, PSIn.UV);
    PSOut.Color = tex * PSIn.Color;
}
